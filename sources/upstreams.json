{
  "userAgent": "okhttp/4.12.0",
  "maxCandidates": 800,
  "maxAliveChannels": 120,
  "maxLatencyMs": 3500,
  "keepPerChannel": 2,
  "probeConcurrency": 40,
  "probeTimeoutMs": 6000,
  "refreshHours": 6,
  "allowIpHost": true,
  "skipHeavyQuality": false,
  "prefer4K": true,
  "minQuality": 2,
  "preferChinese": true,
  "preferNonIp": true,
  "wishlistOnly": true,
  "keepLocalOnFail": false,
  "blockHostPattern": "^localhost$|\\.local$",
  "subscribe": [],
  "seed": []
}
